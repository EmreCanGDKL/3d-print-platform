BACKEND_URL="https://your-backend-host.example.com"
# UploadThing Dashboard > API Keys > V7 sekmesinden alınan token.
# Localde frontend dev server yeniden başlatılmalı; canlıda Netlify Environment Variables içine de eklenmeli.
UPLOADTHING_TOKEN="your-uploadthing-v7-token"
# Canlıda önerilir: https://your-netlify-site.netlify.app/api/uploadthing
UPLOADTHING_CALLBACK_URL="https://your-netlify-site.netlify.app/api/uploadthing"
