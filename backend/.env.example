DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="https://your-netlify-site.netlify.app"
FRONTEND_URLS="http://localhost:3000,http://localhost:3002,https://your-netlify-site.netlify.app"
AI_RATE_LIMIT_MAX="5"
AI_RATE_LIMIT_WINDOW_MS="900000"

# Image search provider. Use SerpApi in new deployments because Google Custom Search JSON API can be unavailable for new projects.
IMAGE_SEARCH_PROVIDER="serpapi"
SERPAPI_API_KEY=""

# Pick the provider you use for AI generation and fill its credentials.
TRIPO_API_KEY=""
HITEM3D_ACCESS_KEY=""
HITEM3D_SECRET_KEY=""
HITEM3D_RESOLUTION="512"
HITEM3D_FACE_COUNT="800000"
HITEM3D_MODEL="hitem3dv1.5"
